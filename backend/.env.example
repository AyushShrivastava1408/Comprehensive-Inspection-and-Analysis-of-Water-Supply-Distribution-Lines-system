SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-another-long-random-string
# Default SQLite hai (instance/inspection.db). PostgreSQL ke liye:
# DATABASE_URL=postgresql://user:pass@localhost:5432/pipeline_db

# --- Model ---
YOLO_WEIGHTS=models/best.pt
YOLO_DEVICE=            # khali = auto | cpu | 0 (GPU)
YOLO_IMGSZ=640          # jis size pe train kiya wahi rakho
CONF_THRESHOLD=0.25

# --- Preprocessing (jo training mein use kiya wahi rakho) ---
APPLY_CLAHE=1
APPLY_DENOISE=1
PROCESS_MAX_SIDE=1920

# --- Upload limits ---
MAX_IMAGE_MB=20
MAX_FILES_PER_UPLOAD=50

CORS_ORIGINS=*          # production mein apna React URL: http://localhost:5173
